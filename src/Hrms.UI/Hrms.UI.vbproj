<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Hrms.UI</RootNamespace>
    <RootNamespace>Hrms.BLL</RootNamespace>
    <AssemblyName>Hrms.UI</AssemblyName>
    <StartupObject>Hrms.UI.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Auth\**" />
    <EmbeddedResource Remove="Auth\**" />
    <None Remove="Auth\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Infrastructure\BaseForm.vb" />
    <Compile Remove="Revolution.Hrms.UI\Program.vb" />
    <Compile Remove="Shared\MenuBuilder.vb" />
    <Compile Remove="Theme\AppTheme.vb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hrms.Models\Hrms.Models.vbproj" />
    <ProjectReference Include="..\Hrms.BLL\Hrms.BLL.vbproj" />
    <ProjectReference Include="..\Hrms.Common\Hrms.Common.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Theme\" />
  </ItemGroup>

</Project>
